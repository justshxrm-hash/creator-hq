    <meta property="og:title" content="CreatorHQ — Watch. Support. Get paid." />
    <meta property="og:description" content="Creators earn. Audiences watch, interact, and support favorites. Official Kick embeds. Always-on rooms." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CreatorHQ" />
